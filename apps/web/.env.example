# Public Supabase URL and anon/publishable key live in src/lib/config/public-supabase.ts.
# Optional server-only override for Hive Edge Function name (default: v1-hives)
SUPABASE_HIVE_EDGE_FUNCTION=v1-hives
# Optional server-only override for document Edge Function name (default: v1-documents)
SUPABASE_DOCUMENT_EDGE_FUNCTION=v1-documents
# Upload limits are defined in Supabase hive3.upload_product_policy (P1.6).

# P1.5-processing (Vercel server / Inngest — set in Vercel project env, not in browser)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   # Inngest onFailure terminal recovery only
# INNGEST_EVENT_KEY=           # send study-run queued events
# INNGEST_SIGNING_KEY=         # usually injected by Vercel ↔ Inngest integration
# WORKER_ORACLE_BASE_URL=      # e.g. https://worker.example.oracle.cloud (no trailing path)
# WORKER_SERVICE_TOKEN=        # must match Oracle Worker WORKER_SERVICE_TOKEN
# WORKER_HTTP_TIMEOUT_MS=300000
