# Public Supabase URL and anon/publishable key live in src/lib/config/public-supabase.ts.
# Optional server-only override for Hive Edge Function name (default: v1-hives)
SUPABASE_HIVE_EDGE_FUNCTION=v1-hives
# Optional server-only override for document Edge Function name (default: v1-documents)
SUPABASE_DOCUMENT_EDGE_FUNCTION=v1-documents
# Upload limits are defined in Supabase hive3.upload_product_policy (P1.6).
