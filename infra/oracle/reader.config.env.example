# Non-secret Reader defaults (Oracle). Secrets belong in host env only.
READER_GIT_SHA=
READER_MAX_PAGES_DEFAULT=500
READER_HTTP_TIMEOUT_SECONDS=120

# Supabase service role — download from hive3-source-documents only on Worker-authorized paths.
READER_SUPABASE_URL=
READER_SUPABASE_SERVICE_ROLE_KEY=

# Optional selective OCR via existing Oracle LiteLLM gateway (no direct provider keys).
LITELLM_BASE_URL=
LITELLM_API_KEY=
READER_OCR_LITELLM_ALIAS=

# P2.2 structured extraction (classify/plan/extract model role — same gateway alias as Worker).
READER_P2_REASONING_LITELLM_ALIAS=

# Ignored unless pytest is executing the current test (PYTEST_CURRENT_TEST).
# Setting this on a production process does not enable fixture extraction.
# READER_EXTRACT_DETERMINISTIC=1

# Worker → Reader Bearer token (required for any network-accessible Reader).
READER_SERVICE_TOKEN=

# Headless LibreOffice DOCX → PDF (reproducible_v1). Pin version on Oracle hosts.
READER_LIBREOFFICE_BINARY=soffice
READER_LIBREOFFICE_VERSION_PIN=7.6.7.2
READER_LIBREOFFICE_RENDER_TIMEOUT_SECONDS=120
