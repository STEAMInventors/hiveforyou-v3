# Non-secret Worker defaults (Oracle). Secrets belong in host env only.

# Domain pack files (declarative, optional).
DOMAIN_PACKS_ROOT=/opt/hiveforyou/domain-packs

# P2.2 reasoning alias — same LiteLLM role alias as Reader extract/classify/plan when LLM steps run.
WORKER_P2_REASONING_LITELLM_ALIAS=

# P2.2-PX selected-Pack extraction (Worker-owned; separate from reasoning alias). Fail closed if unset.
# Off by default. When 1, runs with a UI-submitted domain_hint use the selected-Pack path (IEP 2.0.0).
# A non-null domain_hint never falls back to generic extraction. Pack-free runs omit domain_hint.
# Requires Gate 2b SQL applied.
WORKER_ENABLE_PACK_EXTRACTION=0
WORKER_P2_EXTRACTION_LITELLM_ALIAS=
# Context budget for window planning (Mode A whole document / Mode B page windows). Per-alias limits UNVERIFIED.
# WORKER_P2_EXTRACTION_MAX_CONTEXT_TOKENS=128000
# WORKER_P2_EXTRACTION_OUTPUT_RESERVE_TOKENS=8192
# Optional: attach cache_control on the system block only (provider support UNVERIFIED in repo; prefer gateway injection).
# WORKER_P2_EXTRACTION_ATTACH_CACHE_CONTROL=0
# Bounded document-level concurrency for selected-Pack extraction (supported 1..4; default 2 until provider limits are verified).
# WORKER_P2_EXTRACTION_CONCURRENCY=2

LITELLM_BASE_URL=
LITELLM_API_KEY=

# P1.5-processing: Inngest Connect (outbound) runs hive3-process-study-run on this host.
# Diagnostic HTTP entry (local/tools only; not required on the public internet).
WORKER_HTTP_PORT=8081
WORKER_SERVICE_TOKEN=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1
# WORKER_INNGEST_APP_VERSION=
# WORKER_INNGEST_INSTANCE_ID=
# WORKER_INNGEST_MAX_CONCURRENCY=5
READER_BASE_URL=
READER_SERVICE_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_READER_HTTP_TIMEOUT_MS=120000
