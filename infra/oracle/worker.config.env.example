# Non-secret Worker defaults (Oracle). Secrets belong in host env only.

# Domain pack files (declarative, optional).
DOMAIN_PACKS_ROOT=/opt/hiveforyou/domain-packs

# P2.2 reasoning alias — same LiteLLM role alias as Reader extract/classify/plan when LLM steps run.
WORKER_P2_REASONING_LITELLM_ALIAS=

LITELLM_BASE_URL=
LITELLM_API_KEY=

# P1.5-processing: Inngest Connect (outbound) runs hive3-process-study-run on this host.
# Diagnostic HTTP entry (local/tools only; not required on the public internet).
WORKER_HTTP_PORT=8081
WORKER_SERVICE_TOKEN=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1
# WORKER_INNGEST_APP_VERSION=
# WORKER_INNGEST_INSTANCE_ID=
# WORKER_INNGEST_MAX_CONCURRENCY=5
READER_BASE_URL=
READER_SERVICE_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_READER_HTTP_TIMEOUT_MS=120000
